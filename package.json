{
	"name": "dadabase",
	"private": true,
	"type": "module",
	"imports": {
		"#src/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3005",
		"build": "vite build",
		"start:nitro": "PORT=3006 node .output/server/index.mjs",
		"start": "PORT=3006 pnpx srvx --prod -s ../client  dist/server/server.js",
		"start:spa": "PORT=3006 node server.js",
		"test:run": "vitest run",
		"test": "vitest",
		"fmt": "biome format --write src",
		"check": "biome check --write src",
		"typecheck": "tsgo --noEmit",
		"type:trace": "pnpm tsgo -b ./tsconfig.json --generateTrace trace-dir --diagnostics && npx @typescript/analyze-trace trace-dir",
		"----db----": "----------",
		"db": "pnpm drizzle-kit",
		"db:reset": "rm -rf ./migrations && pnpm db generate && pnpm db push",
		"db:check": "pnpm drizzle-kit check",
		"migrate": "pnpm drizzle-kit migrate",
		"migrate:gen": "pnpm drizzle-kit generate",
		"push": "pnpm drizzle-kit push",
		"studio": "pnpm drizzle-kit studio",
		"----docker----": "----------",
		"docker:build": "docker build . -f ./Dockerfile --build-arg ENTRYPOINT=main -t dadabase",
		"docker:run": "docker run -p 3006:3006 --env-file .env dadabase",
		"docker:sh": "docker run -it --entrypoint sh dadabase"
	},
