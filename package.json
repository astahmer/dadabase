{
	"name": "dadabase",
	"private": true,
	"type": "module",
	"imports": {
		"#src/*": "./src/*"
	},
	"scripts": {
		"dev": "vite dev --port 3005",
		"build": "vite build",
		"serve": "vite preview",
		"test:run": "vitest run",
		"test": "vitest",
		"fmt": "biome format --write src",
		"check": "biome check --write src",
		"typecheck": "tsc --noEmit",
		"type:trace": "pnpm tsc -b ./tsconfig.json --generateTrace trace-dir --diagnostics && npx @typescript/analyze-trace trace-dir",
		"----db----": "----------",
		"db": "pnpm drizzle-kit",
		"db:reset": "rm -rf ./migrations && pnpm db generate && pnpm db push",
		"db:check": "pnpm drizzle-kit check",
		"migrate": "pnpm drizzle-kit migrate",
		"migrate:gen": "pnpm drizzle-kit generate",
		"push": "pnpm drizzle-kit push",
		"studio": "pnpm drizzle-kit studio"
	},
